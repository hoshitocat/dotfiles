[core]
	editor = nvim
	excludesfile = ~/dotfiles/git/ignore

[commit]
	template = ~/dotfiles/git/commit_tmpl
  gpgsign = true

[alias]
  st = status
  co = commit -v
  ch = checkout
  au = add -u
  br = branch
  pu = push -u
  pf = !git pull && git fetch -p
  sync = !git ch main | git pull && git fetch -p && git branch --merged | grep -E -v 'main|master|develop' | xargs git branch -d && git ch -
  main = !git branch | grep -E 'main|master|develop' | awk '{print $2}' | xargs git checkout

[init]
	defaultBranch = main

[pull]
	rebase = false

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = ~/.config/git/allowed_ssh_signers

[diff]
  tool = difftastic
  external = difft

[difftool]
        prompt = false

[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"

[pager]
        difftool = true


# Personal/work identity and signing key stay outside this repository.
[include]
  path = ~/.gitconfig.local
